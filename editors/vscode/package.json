{
  "name": "amscan-report",
  "displayName": "API Model Scanner report",
  "description": "Opens an api_model_scanner report as a real table with checkbox cells, writing ticks straight back to the Markdown the CLI reads.",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JtycEdgeTech/api_model_scanner"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "amscan.report",
        "displayName": "API Model Scanner report",
        "selector": [
          {
            "filenamePattern": "**/.dart_tool/api_model_scanner/unused_fields.md"
          },
          {
            "filenamePattern": "**/.dart_tool/api_model_scanner/disabled_fields.md"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "test": "npm run compile && node --test out/report.test.js",
    "package": "npx --yes @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.6.3"
  }
}
